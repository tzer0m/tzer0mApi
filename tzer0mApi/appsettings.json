{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "PrivatePaths": [
      "/ting/*",
      "/weather/uv/notify",
      "/smartermeter/*",
      "/chitter/*",
      "/eink/*"
    ]
  },
  "Weather": {
    "OpenUV": {
      "BaseUrl": "https://api.openuv.io/api/v1/forecast"
    }
  },
  "HomeAssistant": {
    "BaseUrl": "https://ha.tzer0m.co.uk",
    "Calendars": [ "calendar.personal", "calendar.7_thanet", "calendar.cricket", "calendar.england_holidays", "calendar.tom_oddy_s_facebook_events", "calendar.tom_tzer", "calendar.partiful" ],
    "TasksEntity": "todo.main",
    "WeatherEntity": "weather.forecast_7_thanet_road"
  },
  "SmarterMeter": {
    "CaptureIntervalHours": 1,
    "Gemini": {
      "MaxAttempts": 4,
      "BaseBackoffSeconds": 5
    }
  },
  "Chitter": {
    "Printer": {
      "FeedBefore": 0,
      "FeedAfter": 4
    },
    "Image": {
      "WidthPx": 512,
      "FontPath": "Assets/Fonts/SpaceGrotesk-Medium.ttf",
      "BoldFontPath": "Assets/Fonts/SpaceGrotesk-Bold.ttf",
      "EmojiFontPath": "Assets/Fonts/NotoEmoji-Medium.ttf",
      "CjkFontPath": "Assets/Fonts/NotoSansSC-Medium.ttf",
      "BodyFontSize": 28,
      "FooterFontSize": 18,
      "MarginPx": 12,
      "MaxBandHeightPx": 48,
      "BandDelayMs": 700,
      "MaxImageHeightPx": 480,
      "DensityMode": 3
    }
  }
}